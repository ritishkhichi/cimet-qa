# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets (Deepgram / DB passwords)
.env
.env.*
!.env.example

# uploads
/uploads

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Keep OFF GitHub (local / confidential / mockups) ---
# CIMET handout PDFs
/docs/
# Original redacted call PDF (confidential)
/sample transcripts/
# UI mockup PNGs (local design refs)
/images/

# Uncomment the next line if you also want to hide planning HTML:
/mvp_docs/

